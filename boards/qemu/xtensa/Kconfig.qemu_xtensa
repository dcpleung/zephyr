config BOARD_QEMU_XTENSA
	select SOC_XTENSA_SAMPLE_CONTROLLER32 if BOARD_QEMU_XTENSA_SAMPLE_CONTROLLER32_MPU
	select SOC_XTENSA_DC233C if BOARD_QEMU_XTENSA_DC233C
	select SOC_XTENSA_DC233C if BOARD_QEMU_XTENSA_DC233C_MMU
	select SOC_XTENSA_DC233C if BOARD_QEMU_XTENSA_DC233C_CALL0
	select SOC_XTENSA_DC233C if BOARD_QEMU_XTENSA_DC233C_CALL0_MMU
